#!/usr/bin/env bash
set -euo pipefail

BM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bm"
BM_FILE="$BM_DIR/bookmarks"

usage() {
  cat <<EOF
Usage: bm <command> [<args>]

Commands:
  add <name>     Bookmark the current directory as <name>
  go <name>      Change to the bookmarked directory <name>
  list, ls       List all bookmarks
  del, rm <name> Remove a bookmark
  path <name>    Print the path of a bookmark
  help           Show this help message
EOF
}

ensure_dir() {
  mkdir -p "$BM_DIR"
}

list_bookmarks() {
  if [[ ! -f "$BM_FILE" ]]; then
    echo "No bookmarks yet."
    return
  fi
  if [[ ! -s "$BM_FILE" ]]; then
    echo "No bookmarks yet."
    return
  fi
  printf "%-20s %s\n" "NAME" "PATH"
  printf "%-20s %s\n" "----" "----"
  while IFS='=' read -r name path; do
    printf "%-20s %s\n" "$name" "$path"
  done < "$BM_FILE"
}

add_bookmark() {
  local name="$1"
  local path="$(pwd)"
  ensure_dir
  if grep -q "^$name=" "$BM_FILE" 2>/dev/null; then
    echo "Bookmark '$name' already exists. Overwrite? [y/N]"
    read -r resp
    [[ "$resp" != "y" && "$resp" != "Y" ]] && return
    grep -v "^$name=" "$BM_FILE" > "${BM_FILE}.tmp" && mv "${BM_FILE}.tmp" "$BM_FILE"
  fi
  echo "$name=$path" >> "$BM_FILE"
  echo "Bookmarked '$name' -> $path"
}

go_bookmark() {
  local name="$1"
  if [[ ! -f "$BM_FILE" ]]; then
    echo "Error: no bookmarks file. Add one first." >&2
    return 1
  fi
  local path
  path=$(grep "^$name=" "$BM_FILE" | head -1 | cut -d= -f2-)
  if [[ -z "$path" ]]; then
    echo "Error: bookmark '$name' not found." >&2
    return 1
  fi
  if [[ ! -d "$path" ]]; then
    echo "Error: bookmarked path '$path' no longer exists." >&2
    return 1
  fi
  echo "$path"
}

del_bookmark() {
  local name="$1"
  if [[ ! -f "$BM_FILE" ]]; then
    echo "Error: no bookmarks file." >&2
    return 1
  fi
  if ! grep -q "^$name=" "$BM_FILE" 2>/dev/null; then
    echo "Error: bookmark '$name' not found." >&2
    return 1
  fi
  grep -v "^$name=" "$BM_FILE" > "${BM_FILE}.tmp" && mv "${BM_FILE}.tmp" "$BM_FILE"
  echo "Removed bookmark '$name'."
}

case "${1:-help}" in
  add)
    [[ -z "${2:-}" ]] && { echo "Usage: bm add <name>" >&2; exit 1; }
    add_bookmark "$2"
    ;;
  go)
    [[ -z "${2:-}" ]] && { echo "Usage: bm go <name>" >&2; exit 1; }
    go_bookmark "$2"
    ;;
  list|ls)
    list_bookmarks
    ;;
  del|rm)
    [[ -z "${2:-}" ]] && { echo "Usage: bm del <name>" >&2; exit 1; }
    del_bookmark "$2"
    ;;
  path)
    [[ -z "${2:-}" ]] && { echo "Usage: bm path <name>" >&2; exit 1; }
    go_bookmark "$2"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage
    exit 1
    ;;
esac
