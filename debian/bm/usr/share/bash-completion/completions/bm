_bm_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"

  local commands="add go list del rm path help"

  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=($(compgen -W "$commands" -- "$cur"))
  elif [[ $COMP_CWORD -eq 2 ]]; then
    case "$prev" in
      go|del|rm|path)
        local bookmarks=""
        local bm_file="${XDG_CONFIG_HOME:-$HOME/.config}/bm/bookmarks"
        if [[ -f "$bm_file" ]]; then
          bookmarks=$(cut -d= -f1 "$bm_file" 2>/dev/null)
        fi
        COMPREPLY=($(compgen -W "$bookmarks" -- "$cur"))
        ;;
    esac
  fi
}

complete -F _bm_completions bm
